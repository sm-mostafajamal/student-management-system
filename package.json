    "autoprefixer": "^10.5.4",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.25",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
