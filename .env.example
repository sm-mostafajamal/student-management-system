# PostgreSQL connection string used by Prisma (prisma/schema.prisma → datasource db,
# and prisma.config.ts). Required — the app will not boot or migrate without it.
DATABASE_URL=

# Set automatically by Next.js CLI commands (dev/build/start) — you do not need to
# set this yourself. Listed here only because src/lib/prisma.ts and
# src/app/api/role/route.ts branch on it (query logging in dev, secure cookies in prod).
NODE_ENV=